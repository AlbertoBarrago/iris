msgid "A message goes out under one standard or the other. {pgp} {smime}"
msgstr "Un messaggio parte con l'uno o l'altro standard. {pgp} {smime}"

#: appcore/src/protection.rs:554
msgid ""
"This key does not name {sender}, the address the message says it is from."
msgstr ""
"Questa chiave non indica {sender}, l'indirizzo da cui il messaggio dice di "
"provenire."

#: appcore/src/protection.rs:558
msgid ""
"This certificate does not name {sender}, the address the message says it is "
"from."
msgstr ""
"Questo certificato non indica {sender}, l'indirizzo da cui il messaggio dice "
"di provenire."

#: appcore/src/protection.rs:567
msgid "Signed by {signer}"
msgstr "Firmato da {signer}"

#: appcore/src/protection.rs:573
msgid "This message changed after it was signed"
msgstr "Questo messaggio è cambiato dopo essere stato firmato"

#: appcore/src/protection.rs:575
msgid "The signature of {signer} does not match what arrived."
msgstr "La firma di {signer} non corrisponde a ciò che è arrivato."

#: appcore/src/protection.rs:582
msgid "Signed by {signer}, whose key has expired"
msgstr "Firmato da {signer}, la cui chiave è scaduta"

#: appcore/src/protection.rs:586
msgid "The text is as it was written, and the key behind it ran out."
msgstr ""
"Il testo è come è stato scritto, ma la chiave che lo garantisce è scaduta."

#: appcore/src/protection.rs:592
msgid "Signed by {signer}, whose certificate has run out"
msgstr "Firmato da {signer}, il cui certificato è scaduto"

#: appcore/src/protection.rs:596
msgid ""
"The text is as it was written, and the certificate behind it has expired."
msgstr ""
"Il testo è come è stato scritto, ma il certificato che lo garantisce è "
"scaduto."

#: appcore/src/protection.rs:602
msgid "Signed by {signer}, who took this key back"
msgstr "Firmato da {signer}, che ha revocato questa chiave"

#: appcore/src/protection.rs:606
msgid "The owner revoked it, so it says nothing about who wrote this."
msgstr ""
"Il proprietario l'ha revocata, quindi non dice nulla su chi ha scritto "
"questo."

#: appcore/src/protection.rs:612
msgid "Signed by {signer}, whose certificate was taken back"
msgstr "Firmato da {signer}, il cui certificato è stato revocato"

#: appcore/src/protection.rs:616
msgid "Whoever issued it revoked it, so it says nothing about who wrote this."
msgstr ""
"Chi l'ha emesso l'ha revocato, quindi non dice nulla su chi ha scritto "
"questo."

#: appcore/src/protection.rs:622
msgid "Signed by {signer}, and the signature has run out"
msgstr "Firmato da {signer}, ma la firma è scaduta"

#: appcore/src/protection.rs:626
msgid "It carried a date to stop being good on, and that date has passed."
msgstr "Aveva una data di scadenza, e quella data è passata."

#: appcore/src/protection.rs:631
msgid "Signed by a key this computer does not hold"
msgstr "Firmato con una chiave che questo computer non possiede"

#: appcore/src/protection.rs:633
msgid "Nothing here can check it. Ask gpg for key {key}."
msgstr "Qui nulla può verificarla. Chiedi a gpg la chiave {key}."

#: appcore/src/protection.rs:640
msgid "it names"
msgstr "indica"

#: appcore/src/protection.rs:646
msgid "Signed by a certificate this computer does not hold"
msgstr "Firmato con un certificato che questo computer non possiede"

#: appcore/src/protection.rs:648
msgid ""
"The message carried none either, so there is nothing here to check it "
"against."
msgstr ""
"Nemmeno il messaggio ne conteneva uno, quindi qui non c'è nulla con cui "
"verificarla."

#: appcore/src/protection.rs:654
msgid "gpg could not check this signature"
msgstr "gpg non è riuscito a verificare questa firma"

#: appcore/src/protection.rs:659
msgid "gpgsm could not check this signature"
msgstr "gpgsm non è riuscito a verificare questa firma"

#: appcore/src/protection.rs:682
msgid "Encrypted, and signed by {signer}"
msgstr "Cifrato e firmato da {signer}"

#: appcore/src/protection.rs:691
msgid "Encrypted. {what}"
msgstr "Cifrato. {what}"

#: appcore/src/protection.rs:697
msgid "This message arrived encrypted"
msgstr "Questo messaggio è arrivato cifrato"

#: appcore/src/protection.rs:699
msgid "Nobody signed it, so it says nothing about who sent it."
msgstr "Nessuno l'ha firmato, quindi non dice nulla su chi l'ha inviato."

#: appcore/src/protection.rs:707
msgid "{detail} {files}"
msgstr "{detail} {files}"

#: appcore/src/protection.rs:721
msgid "This message is encrypted to a key you do not hold"
msgstr "Questo messaggio è cifrato per una chiave che non possiedi"

#: appcore/src/protection.rs:723
msgid "Whoever sent it used a key gpg has no secret half of."
msgstr ""
"Chi l'ha inviato ha usato una chiave di cui gpg non ha la parte segreta."

#: appcore/src/protection.rs:728
msgid "This message is encrypted to a certificate you do not hold"
msgstr "Questo messaggio è cifrato per un certificato che non possiedi"

#: appcore/src/protection.rs:730
msgid "Whoever sent it used a certificate gpgsm has no secret key for."
msgstr ""
"Chi l'ha inviato ha usato un certificato per cui gpgsm non ha la chiave "
"segreta."

#: appcore/src/protection.rs:736
msgid "This message says it is OpenPGP and is not"
msgstr "Questo messaggio dice di essere OpenPGP ma non lo è"

#: appcore/src/protection.rs:737
msgid "This message says it is S/MIME and is not"
msgstr "Questo messaggio dice di essere S/MIME ma non lo è"

#: appcore/src/protection.rs:740
msgid "Its parts are not where a signed or encrypted message keeps them."
msgstr "Le sue parti non sono dove un messaggio firmato o cifrato le tiene."

#: appcore/src/protection.rs:746
msgid "gpg could not open this message"
msgstr "gpg non è riuscito ad aprire questo messaggio"

#: appcore/src/protection.rs:747
msgid "gpgsm could not open this message"
msgstr "gpgsm non è riuscito ad aprire questo messaggio"

#: appcore/src/protection.rs:760
msgid "You marked this key as one not to trust."
msgstr "Hai segnato questa chiave come non attendibile."

#: appcore/src/protection.rs:761
msgid "This is one of your own keys."
msgstr "Questa è una delle tue chiavi."

#: appcore/src/protection.rs:762
msgid "You have vouched for this key."
msgstr "Hai garantito per questa chiave."

#: appcore/src/protection.rs:764
msgid ""
"Only people you partly trust have vouched for this key, so it is not fully "
"checked."
msgstr ""
"Solo persone di cui ti fidi in parte hanno garantito per questa chiave, "
"quindi non è verificata del tutto."

#: appcore/src/protection.rs:767
msgid "Nobody has vouched for this key, so it names no one."
msgstr "Nessuno ha garantito per questa chiave, quindi non identifica nessuno."

#: appcore/src/protection.rs:770
msgid ""
"Its certificate leads back to an authority you trust, but this computer "
"could not check whether it was revoked."
msgstr ""
"Il suo certificato risale a un'autorità di cui ti fidi, ma questo computer "
"non ha potuto verificare se è stato revocato."

#: appcore/src/protection.rs:774
msgid "Its certificate leads back to an authority you trust."
msgstr "Il suo certificato risale a un'autorità di cui ti fidi."

#: appcore/src/protection.rs:777
msgid "Its certificate leads back to nobody you trust, so it names no one."
msgstr ""
"Il suo certificato non risale a nessuno di cui ti fidi, quindi non "
"identifica nessuno."

#: appcore/src/protection.rs:780
msgid "Nothing here says who that certificate belongs to."
msgstr "Qui nulla indica a chi appartiene quel certificato."

#: appcore/src/protection.rs:816
msgid "key {key}"
msgstr "chiave {key}"

#: appcore/src/protection.rs:819
msgid "a key gpg would not name"
msgstr "una chiave che gpg non identifica"

#: appcore/src/protection.rs:820
msgid "a certificate gpgsm would not name"
msgstr "un certificato che gpgsm non identifica"

