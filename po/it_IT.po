msgid ""
"Reading the contacts of {account} needs one more permission. {company} asks "
"you to confirm in your browser. Names and photos stay on this computer."
msgstr ""
"Leggere i contatti di {account} richiede un permesso in più. {company} ti "
"chiede di confermare nel browser. Nomi e foto restano su questo computer."

#: appcore/src/permission.rs:145
msgid "Allow Iris to Change Your Contacts"
msgstr "Consenti a Iris di modificare i tuoi contatti"

#: appcore/src/permission.rs:147
msgid ""
"The assistant needs permission to add and change the contacts of {account}. "
"{company} asks you to confirm in your browser."
msgstr ""
"L'assistente ha bisogno del permesso per aggiungere e modificare i contatti "
"di {account}. {company} ti chiede di confermare nel browser."

