msgid "No answer on port {port}"
msgstr "Nessuna risposta sulla porta {port}"

#: appcore/src/add_account.rs:808
msgid ""
"The server did not answer. Check the server name and port, or try again when "
"you are online."
msgstr ""
"Il server non ha risposto. Controlla il nome del server e la porta, o "
"riprova quando sei online."

#: appcore/src/add_account.rs:828
msgid ""
"{host} answered but turned down another connection. Try again in a few "
"minutes."
msgstr ""
"{host} ha risposto ma ha rifiutato un'altra connessione. Riprova tra qualche "
"minuto."

#: appcore/src/add_account.rs:832
msgid "Too many connections"
msgstr "Troppe connessioni"

#: appcore/src/add_account.rs:838
msgid "{host} answered in a way this app cannot work with."
msgstr "{host} ha risposto in un modo che questa app non sa gestire."

