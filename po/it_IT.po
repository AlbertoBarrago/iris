msgstr ""
"S/MIME indica ogni destinatario all'interno di un messaggio cifrato, quindi "
"una copia nascosta non resterebbe nascosta."

#: appcore/src/protection.rs:248
msgid "Signed"
msgstr "Firmato"

#: appcore/src/protection.rs:249
msgid "Encrypted"
msgstr "Cifrato"

#: appcore/src/protection.rs:250
msgid "Signed and encrypted"
msgstr "Firmato e cifrato"

#: appcore/src/protection.rs:259
msgid "Encrypt this message to the recipients' keys"
msgstr "Cifra questo messaggio con le chiavi dei destinatari"

#: appcore/src/protection.rs:260
msgid "Encrypt this message to the recipients' certificates"
msgstr "Cifra questo messaggio con i certificati dei destinatari"

#: appcore/src/protection.rs:286
msgid "gpg holds no key and gpgsm no trusted certificate for {addresses}."
msgstr ""
"gpg non ha alcuna chiave e gpgsm alcun certificato attendibile per "
"{addresses}."

